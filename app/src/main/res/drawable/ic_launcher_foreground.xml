        android:strokeColor="#00D09C"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:pathData="M 49,25 A 22,22 0 1 1 48.9,25 Z" />
    
    <!-- Lens Handle angled down-right -->
    <path
        android:strokeColor="#00D09C"
        android:strokeWidth="5.5"
        android:strokeLineCap="round"
        android:pathData="M 65,63 L 81,79" />
    
    <!-- Inner Lens highlight arc -->
    <path
