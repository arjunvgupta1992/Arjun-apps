    <!-- Rupee Symbol ₹ centered inside lens (X: 39-59, Y: 35-59) -->
    <!-- Top Horizontal Bar -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3.2"
        android:strokeLineCap="round"
        android:pathData="M 40,37 L 57,37" />
