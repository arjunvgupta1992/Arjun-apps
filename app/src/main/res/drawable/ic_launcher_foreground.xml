    <path
        android:strokeColor="#FFC107"
        android:strokeWidth="3.4"
        android:strokeLineCap="round"
        android:pathData="M 45,50 L 56,60" />
    
    <!-- AI Sparkle star at top right of the lens -->
    <path
        android:fillColor="#FFC107"
        android:pathData="M 74,27 L 76,32 L 81,34 L 76,36 L 74,41 L 72,36 L 67,34 L 72,32 Z" />
